---
import { getCollection } from 'astro:content';

interface Props {
  locale: 'ja' | 'en';
  category: 'script-and-phonology' | 'grammar' | 'readings';
}

const { locale, category } = Astro.props;

const LANGUAGE_NAMES: Record<string, { ja: string; en: string }> = {
  sumerian: { ja: 'シュメール語', en: 'Sumerian' },
  akkadian: { ja: 'アッカド語', en: 'Akkadian' },
  sanskrit: { ja: 'サンスクリット語', en: 'Sanskrit' },
  hittite: { ja: 'ヒッタイト語', en: 'Hittite' },
  'old-egyptian': { ja: '古エジプト語', en: 'Old Egyptian' },
  aramaic: { ja: 'アラム語', en: 'Aramaic' },
  maya: { ja: 'マヤ語', en: 'Maya' },
  'old-norse': { ja: '古ノルド語', en: 'Old Norse' },
};

const CATEGORY_NAMES: Record<Props['category'], { ja: string; en: string }> = {
  'script-and-phonology': { ja: '文字と音韻', en: 'Script & Phonology' },
  grammar: { ja: '基礎文法', en: 'Basic Grammar' },
  readings: { ja: '読解・例文', en: 'Readings & Examples' },
};

// Distinct hue per language so each language's thumbnails read as a
// consistent "channel" color, the way a YouTube channel has a look.
const LANGUAGE_HUE: Record<string, number> = {
  sumerian: 205,
  akkadian: 15,
  sanskrit: 35,
  hittite: 265,
  'old-egyptian': 45,
  aramaic: 165,
  maya: 340,
  'old-norse': 220,
};

const idPrefix = locale === 'en' ? `en/${category}/` : `${category}/`;

const allDocs = await getCollection('docs');
const entries = allDocs
  .filter((entry) => entry.id.startsWith(idPrefix) && entry.data.topic)
  .sort((a, b) => {
    const orderA = a.data.sidebar?.order ?? Number.MAX_SAFE_INTEGER;
    const orderB = b.data.sidebar?.order ?? Number.MAX_SAFE_INTEGER;
    if (orderA !== orderB) return orderA - orderB;
    return a.id.localeCompare(b.id);
  });

const catName = CATEGORY_NAMES[category][locale];
---

<div class="pl-yt-grid">
  {
    entries.map((entry, i) => {
      const topic = entry.data.topic!;
      const slug = entry.id.slice(idPrefix.length);
      const href = locale === 'en' ? `/en/${category}/${slug}/` : `/${category}/${slug}/`;
      const icon = i % 2 === 0 ? 'boy-icon-smile.png' : 'girl-icon-sparkle.png';
      const iconSrc = `/images/characters/${topic}/${icon}`;
      const hue = LANGUAGE_HUE[topic] ?? 210;
      const langName = LANGUAGE_NAMES[topic]?.[locale] ?? topic;

      return (
        <a class="pl-yt-card" href={href}>
          <div class="pl-yt-thumb" style={`--pl-hue:${hue}`}>
            <img src={iconSrc} alt="" loading="lazy" />
          </div>
          <div class="pl-yt-meta">
            <img class="pl-yt-avatar" src={iconSrc} alt="" loading="lazy" />
            <div class="pl-yt-text">
              <p class="pl-yt-title">{entry.data.title}</p>
              <p class="pl-yt-sub">
                {langName} ・ {catName}
              </p>
            </div>
          </div>
        </a>
      );
    })
  }
</div>

<style>
  .pl-yt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.75rem 1.1rem;
    margin: 1.25rem 0 2rem;
  }

  .pl-yt-card {
    display: block;
    color: inherit;
    text-decoration: none;
    border-radius: 0.75rem;
    transition: transform 0.15s ease;
  }

  .pl-yt-card:hover {
    transform: translateY(-3px);
  }

  .pl-yt-card:hover .pl-yt-title {
    color: var(--sl-color-accent-high);
  }

  .pl-yt-thumb {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    background: linear-gradient(
      160deg,
      hsl(var(--pl-hue) 35% 22%),
      hsl(var(--pl-hue) 45% 12%)
    );
  }

  :root[data-theme='light'] .pl-yt-thumb {
    background: linear-gradient(
      160deg,
      hsl(var(--pl-hue) 75% 93%),
      hsl(var(--pl-hue) 65% 83%)
    );
  }

  .pl-yt-thumb img {
    height: 74%;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.25));
  }

  .pl-yt-meta {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-top: 0.65rem;
  }

  .pl-yt-avatar {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    object-fit: contain;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    padding: 3px;
  }

  .pl-yt-text {
    min-width: 0;
  }

  .pl-yt-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pl-yt-sub {
    margin: 0.25rem 0 0;
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }
</style>
